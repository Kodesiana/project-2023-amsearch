   "source": [
    "import pathlib\n",
    "\n",
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "for json_path in pathlib.Path(\"../data/cleaned\").glob(\"*.jsonl\"):\n",
    "    df = pd.read_json(json_path, lines=True)\n",
    "\n",
    "    save_path = json_path.parent / (json_path.stem + \".csv\")\n",
    "    df.to_csv(save_path, index=None)"
   ]
  },
